# ============================================================
# Eye Multi-Agent System - 环境变量配置模板
# 复制本文件为 .env 后填入实际值：cp .env.example .env
# ============================================================

# --- VLM / LLM API 配置（GPT-5 或 OpenAI 兼容接口）---
GPT_API_URL=https://your-api-endpoint/v1
GPT_API_KEY=your-api-key

# --- Qwen API（可选，用于模型对比评测）---
QWEN_API_URL=https://your-qwen-endpoint/v1
QWEN_API_KEY=your-qwen-api-key

# --- eye-mcp 路径（可选，默认与本项目同级 ../eye-mcp）---
# EYE_MCP_DIR=/path/to/eye-mcp
